# ----------------------------------------------------------------- aplicação
NODE_ENV=development
PORT=3333
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ------------------------------------------------------------------- database
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/clinistudio?schema=public"

# ----------------------------------------------------------------- segurança
JWT_SECRET="troque-este-valor-por-um-segredo-forte-de-32-chars"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET="troque-este-outro-valor-por-um-segredo-forte"
REFRESH_TOKEN_EXPIRES_DAYS=30

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_WRITE_RATE_LIMIT_MAX=30

# --------------------------------------------------------------------- redis
# Defina REDIS_ENABLED=false para rodar sem Redis (filas viram no-op).
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------------- saas
DEFAULT_TRIAL_DAYS=14

# ------------------------------------------------------------------- horário
# A agenda trabalha com horário de parede. Em servidor UTC os horários sairiam
# deslocados, então o fuso é fixado no processo.
TIMEZONE=America/Sao_Paulo
PUBLIC_URL=http://localhost:3333

# ------------------------------------------------------------------- painel
# Base do painel. Entra nos e-mails: link de redefinir senha, link de pagar.
APP_URL=http://localhost:5173

# ----------------------------------------------------------------- cobrança
# Asaas. Sem chave a cobrança fica desligada: o painel avisa que o pagamento
# não está configurado e NENHUMA conta é bloqueada por trial vencido — não
# haveria como pagar para destravar.
# ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Segredo combinado no cadastro do webhook; o Asaas o devolve no header
# asaas-access-token. Sem conferir isso, qualquer um poderia postar
# "pagamento confirmado" no nosso endpoint. Em produção é obrigatório.
# ASAAS_WEBHOOK_TOKEN=
# Dias de tolerância após o vencimento antes de trancar o painel. Boleto
# compensa em dias úteis; trancar no dia seguinte puniria quem já pagou.
BILLING_GRACE_DAYS=5

# ------------------------------------------------------------------- e-mail
# Sem SMTP_HOST o e-mail vira log — em desenvolvimento o link de redefinir
# senha aparece no terminal. Em produção, faltar SMTP é registrado como erro.
# SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="CliniStudio <nao-responda@clinistudio.app>"

# ------------------------------------------------------- segundo fator (2FA)
# Chave da cifra dos segredos do 2FA guardados no banco. Sem ela derivamos do
# REFRESH_TOKEN_SECRET — mas aí trocar aquele inutiliza o 2FA de todo mundo,
# então em producao defina a sua (32+ caracteres aleatorios).
# ENCRYPTION_KEY=
