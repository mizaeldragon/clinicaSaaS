# ----------------------------------------------------------------- aplicação
NODE_ENV=development
PORT=3333
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ------------------------------------------------------------------- database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beauty_saas?schema=public"

# ----------------------------------------------------------------- segurança
JWT_SECRET="troque-este-valor-por-um-segredo-forte-de-32-chars"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET="troque-este-outro-valor-por-um-segredo-forte"
REFRESH_TOKEN_EXPIRES_DAYS=30

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --------------------------------------------------------------------- redis
# Defina REDIS_ENABLED=false para rodar sem Redis (filas viram no-op).
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6380

# ----------------------------------------------------------------------- saas
DEFAULT_TRIAL_DAYS=14
